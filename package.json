{
  "name": "@geezerrrr/watercooler",
  "version": "0.4.1",
  "description": "A pixel office you walk around with other people — one world, shared rooms, voice chat",
  "license": "MIT",
  "bin": {
    "watercooler": "bin/watercooler.mjs"
  },
  "files": [
    "bin/",
    ".next/standalone/"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "dev:next": "next dev",
    "build": "tsx scripts/build-assets.ts && next build",
    "start": "node scripts/start.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run --project unit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "prepublishOnly": "node scripts/prepare-package.mjs",
    "zoho:setup": "node scripts/zoho-setup.mjs",
    "build:map": "tsx scripts/build-map.ts && tsx scripts/build-assets.ts",
    "build:art": "tsx scripts/make-world-art.mjs",
    "check:sheets": "tsx scripts/check-sheets.ts",
    "check:delivery": "tsx scripts/check-delivery.ts",
    "assets": "tsx scripts/build-assets.ts",
    "test:all": "vitest --run",
    "test:slow": "vitest --run --project slow",
    "test:changed": "vitest --run --changed",
    "preview:map": "tsx scripts/preview-map.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,js,mjs,css}": [
      "prettier --write"
    ]
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "multiplayer",
    "pixel-art",
    "collaboration",
    "presence",
    "phaser",
    "nextjs"
  ],
  "dependencies": {
    "@next/env": "16.1.6",
    "next-auth": "5.0.0-beta.32",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "husky": "^9",
    "jsdom": "^30.0.1",
    "lint-staged": "^15",
    "lucide-react": "^0.576.0",
    "next": "16.1.6",
    "phaser": "^3.90.0",
    "prettier": "^3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sharp": "^0.34.5",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^3"
  },
  "packageManager": "pnpm@10.20.0"
}
